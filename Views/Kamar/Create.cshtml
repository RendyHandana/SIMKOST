@model SIMKOST.Resources.ViewModels.KamarViewModel

<h2>Tambah Kamar</h2>

<form asp-action="Create">

    <div class="mb-3">
        <label>Nomor Kamar</label>
        <input asp-for="NomorKamar" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Lantai</label>
        <input asp-for="Lantai" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Harga</label>
        <input asp-for="Harga" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Status</label>
        <select asp-for="Status" class="form-control">
            <option value="Kosong">Kosong</option>
            <option value="Terisi">Terisi</option>
        </select>
    </div>

    <button type="submit" class="btn btn-success">
        Simpan
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Kembali
    </a>

</form>