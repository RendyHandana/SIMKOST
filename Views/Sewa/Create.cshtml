@model SIMKOST.Models.Sewa

<h2>Tambah Sewa</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label>Penghuni</label>
        <select asp-for="PenghuniId"
                asp-items="ViewBag.PenghuniId"
                class="form-control">
        </select>
    </div>

    <div class="mb-3">
        <label>Kamar</label>
        <select asp-for="KamarId"
                asp-items="ViewBag.KamarId"
                class="form-control">
        </select>
    </div>

    <div class="mb-3">
        <label>Tanggal Masuk</label>
        <input asp-for="TanggalMasuk"
               type="date"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Tanggal Keluar</label>
        <input asp-for="TanggalKeluar"
               type="date"
               class="form-control" />
    </div>

    <button class="btn btn-success">
        Simpan
    </button>

</form>