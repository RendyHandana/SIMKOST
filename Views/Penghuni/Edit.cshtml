@model SIMKOST.Models.Penghuni

@{
    ViewData["Title"] = "Edit Data Penghuni";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3 mb-0 text-gray-800">📝 Edit Data Penghuni</h2>
        <a asp-action="Index" class="btn btn-secondary px-4 shadow-sm">
            <i class="fas fa-arrow-left me-2"></i>Kembali
        </a>
    </div>

    <div class="card shadow mb-4" style="border-radius: 15px; border: none;">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />
                
                <div class="row">
                    <div class="col-md-7">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nama" class="form-label fw-bold">Nama Lengkap</label>
                                <input asp-for="Nama" class="form-control input-custom" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="NIK" class="form-label fw-bold">NIK</label>
                                <input asp-for="NIK" class="form-control input-custom" required />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="NoHP" class="form-label fw-bold">Nomor HP</label>
                                <input asp-for="NoHP" class="form-control input-custom" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Alamat" class="form-label fw-bold">Alamat Asal</label>
                                <input asp-for="Alamat" class="form-control input-custom" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Update Foto KTP (Opsional)</label>
                            <input type="file" name="fileKtp" class="form-control input-custom" accept="image/*" />
                            <small class="text-muted">Pilih file baru hanya jika ingin mengganti foto KTP.</small>
                        </div>
                    </div>

                    <div class="col-md-5 text-center">
                        <label class="form-label fw-bold">Foto KTP Saat Ini</label>
                        <div class="p-3 bg-light rounded-3 border">
                            @if (!string.IsNullOrEmpty(Model.FotoKTP))
                            {
                                <img src="~/uploads/@Model.FotoKTP" class="img-fluid rounded shadow-sm" alt="Foto KTP" style="max-height: 200px;" />
                            }
                            else
                            {
                                <div class="py-5 text-muted">
                                    <i class="fas fa-image fa-3x mb-2"></i><br />
                                    Tidak ada foto
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="mt-4 border-top pt-3 text-end">
                    <button type="submit" class="btn btn-primary px-5 py-2 shadow-sm" style="background: linear-gradient(135deg, #1e40af, #2563eb); border: none;">
                        <i class="fas fa-save me-2"></i>Simpan Perubahan
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .input-custom {
        border-radius: 8px;
        padding: 10px 14px;
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
    }
</style>