@model IEnumerable<SIMKOST.Models.Penghuni>

@{
    ViewData["Title"] = "Data Penghuni";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3 mb-0 text-gray-800">👥 Data Penghuni</h2>
        <a asp-action="Create" class="btn btn-primary px-4 shadow-sm" style="background: linear-gradient(135deg, #1e40af, #2563eb); border: none;">
            <i class="fas fa-plus me-2"></i>Tambah Penghuni
        </a>
    </div>

    <div class="card shadow mb-4" style="border-radius: 15px; border: none;">
        <div class="card-body p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="min-width: 900px;">
                    <thead class="table-light text-secondary" style="background-color: #f8fafc;">
                        <tr>
                            <th class="py-3 px-4">Nama</th>
                            <th class="py-3">NIK</th>
                            <th class="py-3">No HP</th>
                            <th class="py-3">Alamat</th>
                            <th class="py-3">Status</th>
                            <th class="py-3 text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="py-3 px-4 fw-semibold text-dark">@item.Nama</td>
                                    <td class="text-secondary">@item.NIK</td>
                                    <td class="text-secondary">@item.NoHP</td>
                                    <td class="text-secondary">@item.Alamat</td>
                                    <td>
                                        @if (item.IsAktif)
                                        {
                                            <span class="badge bg-success-subtle text-success rounded-pill px-3">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger rounded-pill px-3">Tidak Aktif</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-white px-3 py-1.5 shadow-sm rounded-3">
                                            <i class="fas fa-edit me-1"></i> Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">Belum ada data penghuni.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>